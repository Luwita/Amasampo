# Copy to server/.env and adjust. All values are optional for local development.

# Port for the API (the React dev server proxies /api here).
PORT=4000

# Leave unset to use the built-in PGlite database stored in server/.data/pg.
# Set to a Postgres connection string in production, e.g. from Neon, Supabase or Render:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Product photos are stored in the database. Photos saved to disk by older versions are still served from here
# (default: server/.data/uploads).
# UPLOAD_DIR=/var/data/uploads

# In production, sign-in codes are never shown in the app.
# NODE_ENV=production

# Phone numbers of Zed Market staff, comma-separated. They get the admin panel at /admin when they sign in.
# ADMIN_PHONES=0977123456,0966123456

# Testing only: show sign-in codes on the sign-in screen, e.g. before the SMS provider is paid for.
# Anyone could then sign in to any customer or shop account, so remove it before real customers use the site.
# Staff and owner codes are never shown; they are written in the server log.
# SHOW_SIGNIN_CODES=1

# Load demo shops and products into an empty database (off by default: shops are added by their owners).
# SEED_DEMO=1

# SMS (sign-in codes) through Africa's Talking. Without these, codes are printed in the server window.
# Testing: AT_USERNAME=sandbox with the sandbox API key, and watch messages in the Africa's Talking simulator.
# Live: your Africa's Talking app username and its API key, plus an approved sender ID (optional).
# Check it with: npm run sms:test -- 0977123456
# AT_USERNAME=sandbox
# AT_API_KEY=your-api-key
# AT_SENDER_ID=ZedMarket

# Testing only: send texts from your own Android phone with the free "SMS Gateway for Android" app
# (https://sms-gate.app). Turn on Cloud Server in the app and copy the username and password it shows.
# These take priority over Africa's Talking while they are set.
# SMS_GATEWAY_USER=ABC123
# SMS_GATEWAY_PASS=the-password-from-the-app
# Only for the app's Local Server mode (phone and computer on the same Wi-Fi):
# SMS_GATEWAY_URL=http://192.168.1.50:8080/message
